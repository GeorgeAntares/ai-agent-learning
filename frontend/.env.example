# Optional deployment API base URL. Leave empty in local Vite development to use /api proxy.
VITE_API_BASE_URL=

# Optional Vite development proxy target. Defaults to http://127.0.0.1:8000.
# The bundled Docker Compose configuration exposes its API at port 18001.
VITE_API_PROXY_TARGET=http://127.0.0.1:18001
